{
  "name": "sys2_exp4b",
  "template": "input/config/config_sys2_exp4b.json",
  "outputRoot": "output/sys2_exp4b",
  "realizations": 10,
  "baseSeed": 8001,
  "grid": {
    "particles.count": [
      50,
      200,
      300,
      400,
      500
    ],
    "obstacles.x0": [
      0.0175,
      0.04,
      0.07,
      0.1,
      0.15,
      0.25,
      0.35,
      0.45,
      0.4925
    ]
  },
  "derived": {
    "simulation.totalTime": "100.0 if {particles.count} <= 50 else (150.0 if {particles.count} <= 200 else (250.0 if {particles.count} <= 300 else (300.0 if {particles.count} <= 400 else 450.0)))",
    "initialCondition.mode": "'hexagonal' if {particles.count} >= 400 else 'random'"
  },
  "jobs": 4
}
