{
  "name": "sys2_exp4b",
  "template": "input/config/config_sys2_exp4b.json",
  "outputRoot": "output/sys2_exp4b",
  "realizations": 10,
  "baseSeed": 8001,
  "grid": {
    "particles.count": [
      25,
      50,
      200,
      300,
      400
    ],
    "obstacles.x0": [
      0.0175,
      0.1,
      0.2,
      0.3,
      0.4,
      0.4925
    ]
  },
  "derived": {
    "simulation.totalTime": "100.0 if {particles.count} <= 50 else (150.0 if {particles.count} <= 200 else (250.0 if {particles.count} <= 300 else 400.0))",
    "initialCondition.mode": "'hexagonal' if {particles.count} >= 400 else 'random'"
  },
  "jobs": 4
}